{
  "name":"premium-agency-website",
  "version":"1.0.0",
  "private":true,
  "type":"module",
  "scripts":{
    "dev":"concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client":"vite --host 0.0.0.0",
    "dev:server":"tsx watch server/index.ts",
    "build":"tsc --noEmit && vite build",
    "start":"tsx server/index.ts",
    "preview":"vite preview --host 0.0.0.0"
  },
  "dependencies":{"express":"^4.21.2","gsap":"3.12.5","three":"^0.170.0"},
  "devDependencies":{"@types/express":"^5.0.0","@types/node":"^22.10.0","@types/three":"^0.170.0","@vitejs/plugin-basic-ssl":"^1.2.0","concurrently":"^9.1.0","sass":"^1.83.0","tsx":"^4.19.2","typescript":"^5.7.2","vite":"^6.0.5"}
}
